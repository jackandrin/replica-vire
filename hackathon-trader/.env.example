# Copy to .env (setup.sh does this) and fill in. Never commit .env.
ALPACA_API_KEY=
ALPACA_API_SECRET=
FINNHUB_API_KEY=

# TigerData (Timescale Cloud) -> service "Connect" tab -> connection string
TIGER_DATABASE_URL=postgres://tsdbadmin:PASSWORD@HOST.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require

# Snowflake (optional until hour ~10). ACCOUNT looks like orgname-accountname
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=HACK_WH
SNOWFLAKE_DATABASE=HACKATHON
SNOWFLAKE_SCHEMA=TRADER
SNOWFLAKE_ROLE=

# Kill switch: set to 0 and decide.py will refuse to submit orders
TRADING_ENABLED=1
