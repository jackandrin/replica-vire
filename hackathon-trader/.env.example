# Copy to .env (setup.sh does this) and fill in. Never commit .env.
ALPACA_API_KEY=
ALPACA_API_SECRET=
FINNHUB_API_KEY=

# TigerData (Timescale Cloud) -> service "Connect" tab -> connection string
TIGER_DATABASE_URL=postgres://tsdbadmin:PASSWORD@HOST.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require

# Snowflake (optional until hour ~10). ACCOUNT looks like orgname-accountname
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=HACK_WH
SNOWFLAKE_DATABASE=HACKATHON
SNOWFLAKE_SCHEMA=TRADER
SNOWFLAKE_ROLE=

# Kill switch: set to 0 and decide.py will refuse to submit orders
TRADING_ENABLED=1

# Dashboard portfolios (live paper trades). The API host also needs ALPACA_API_KEY/SECRET above.
# Optional second paper account dedicated to dashboard portfolios (isolates them from autotrade):
ALPACA_PORTFOLIO_API_KEY=
ALPACA_PORTFOLIO_API_SECRET=
# PORTFOLIO_MAX_BUDGET=10000
# PORTFOLIO_MAX_TOTAL_USD=100000
# PORTFOLIO_MAX_PER_CLIENT_HOUR=5
# PORTFOLIO_MAX_PER_DAY=200

# Dashboard login (single user). Required for Auto-Trading settings and executing recommendations.
DASHBOARD_PASSPHRASE=
# Random string used to sign the session cookie (falls back to the passphrase)
SESSION_SECRET=

# Your name and email, required by SEC EDGAR fair-access policy (used as the User-Agent), e.g. "Jane Doe jane@example.com"
SEC_USER_AGENT=
